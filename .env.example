# Supabase (Project Settings -> API)
SUPABASE_URL=
# Deprecated/unused — Supabase issues ES256 tokens, verified via JWKS
# (SUPABASE_URL + /auth/v1/.well-known/jwks.json) instead of this shared secret.
# Left here in case something else still references it.
SUPABASE_JWT_SECRET=
# Project Settings -> API -> service_role key (secret — bypasses RLS, backend-only)
SUPABASE_SERVICE_ROLE_KEY=

